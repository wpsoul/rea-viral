      },
      "machine_marks": {
        "phrases": ["delve", "delves", "delving", "tapestry", "testament to", "in today's fast-paced",
                    "in today's digital", "ever-evolving", "ever-changing landscape", "navigate the complexities",
                    "unlock the power", "unlock the potential", "unleash", "elevate your", "harness the power",
                    "game-changer", "game changer", "a myriad of", "plethora", "embark on", "in conclusion",
                    "furthermore", "moreover", "it's important to note", "it is important to note", "it's worth noting",
                    "let's dive in", "let's dive into", "buckle up", "picture this", "imagine a world", "realm of",
                    "synergy", "paradigm shift", "seamless", "seamlessly", "cutting-edge", "revolutionize",
                    "revolutionise", "supercharge", "in the ever", "look no further", "stands as a"],
        "patterns": {
          "em dash": "\u2014",
          "\"not just X, but Y\"": "\\bnot (?:just|only|merely)\\b[^.!?\\n]{1,60}?\\bbut(?: also)?\\b",
          "\"it's not X, it's Y\"": "\\b(?:it|this|that)['\u2019]?s not\\b[^.!?\\n]{1,50}?[,.;:]\\s*(?:it|this|that)['\u2019]?s\\b"
        }
      }
    }
  }
}
