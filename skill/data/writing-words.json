        "reply": ["comment *", "comment below", "drop a comment", "leave a comment", "in the comments", "let me know",
                  "reply with *", "reply below", "what do you think", "what would you add", "thoughts?", "agree?",
                  "who else", "drop your *", "tell me your", "tell me in", "tell me below", "your thoughts"],
        "save": ["bookmark this", "bookmark it", "bookmark for later", "save this", "save it", "save for later",
