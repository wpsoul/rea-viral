      "asks": {
        "follow": ["follow me", "follow us", "follow @*", "follow for more", "follow along", "give me a follow",
                   "give us a follow", "hit follow", "smash follow", "be sure to follow", "make sure to follow",
                   "consider following", "turn on notifications", "turn on post notifications", "subscribe for more",
