      "not_names": ["the", "a", "an", "this", "that", "these", "those", "every", "everyone", "everybody", "everything",
                    "nothing", "nobody", "someone", "somebody", "something", "most", "many", "some", "all", "any",
                    "here", "there", "today", "tomorrow", "now", "just", "so", "if", "when", "what", "why", "how",
                    "who", "where", "which", "new", "big", "best", "top", "first", "last", "next", "one", "two",
                    "three", "four", "five", "ten", "my", "your", "our", "their", "his", "her", "its", "and", "but",
                    "or", "after", "before", "because", "since", "while", "once", "still", "even", "only", "also",
                    "again", "yes", "no", "ok", "okay", "hey", "hi", "hello", "dear", "monday", "tuesday",
